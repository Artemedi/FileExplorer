{
  "name": "explr",
  "private": true,
  "version": "0.2.13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/codebase_audit.test.mjs && vitest run",
    "test:ui": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit --checkJs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:macos": "cargo tauri build --target aarch64-apple-darwin && cd src-tauri/scripts && CARGO_CFG_TARGET_ARCH=aarch64 CARGO_CFG_TARGET_OS=macos ./post-build.sh",
    "tauri:build:intel": "cargo tauri build --target x86_64-apple-darwin && cd src-tauri/scripts && CARGO_CFG_TARGET_ARCH=x86_64 CARGO_CFG_TARGET_OS=macos ./post-build.sh",
    "build:universal": "./build-universal.sh",
    "dist": "./build-universal.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
